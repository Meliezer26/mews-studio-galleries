# ============================================================
#  Mews Studio Galleries — configuration
#  Copiez ce fichier en `.env` puis remplissez les valeurs.
# ============================================================

# Port du serveur (défaut : 3000)
PORT=3000

# URL publique du site (obligatoire pour Google OAuth)
# Exemple local : http://localhost:3000
# Exemple prod : https://galeries.monstudio.fr
BASE_URL=http://localhost:3000

# --- Google Drive (voir SETUP.md pour la procédure) ----------
# Créez un projet sur https://console.cloud.google.com,
# activez l'API Google Drive, puis créez un identifiant OAuth
# de type "Application Web".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dossier Drive où écrire la sauvegarde automatique (facultatif).
# Si vide : l'application utilise automatiquement le premier dossier
# partagé avec le robot en « Éditeur ».
# BACKUP_FOLDER_ID=

# OPTION RECOMMANDÉE — compte de service Google (voir SETUP.md) :
# collez ici le contenu COMPLET du fichier JSON de la clé du compte
# de service (sur une seule ligne). Connexion automatique à Google
# Drive, sans écran de consentement et sans expiration — plus besoin
# de GOOGLE_CLIENT_ID/SECRET. Partagez ensuite vos dossiers Drive
# avec l'adresse e-mail du compte de service (en « Éditeur »).
GOOGLE_SERVICE_ACCOUNT_JSON=

# URI de redirection OAuth (défaut : BASE_URL + /oauth2callback)
# À déclarer aussi dans la console Google : "URI de redirection autorisés"
GOOGLE_REDIRECT_URI=

# Mot de passe administrateur (défaut : admin123 en mode démo)
ADMIN_PASSWORD=

# Mettre à 1 si le site est intégré dans une iframe sur un autre domaine
# (ex. une page de votre site Showit). Nécessite HTTPS en production.
EMBED_MODE=0

# --- Sauvegarde automatique des données (indispensable en production) ---
# RECOMMANDÉ : un dépôt GitHub PRIVÉ dédié (ex. « mews-studio-backup »)
# où l'application écrit « mews-studio-data.json » à chaque modification.
# GITHUB_BACKUP_TOKEN : jeton « fine-grained » GitHub (Settings → Developer
# settings → Personal access tokens → Fine-grained tokens) avec la
# permission Contents : Read and write sur ce dépôt uniquement.
# GITHUB_BACKUP_REPO : « proprietaire/nom-du-depot ».
# (Sans ces variables, la sauvegarde va sur Google Drive — impossible en
# mode compte de service, qui n'a pas de quota d'écriture.)
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=

# Jeton de secours Google OAuth (facultatif, recommandé en production)
# Si le disque de l'hébergeur est réinitialisé (Render gratuit...), ce jeton
# permet de re-connecter Google Drive automatiquement puis de restaurer les
# données depuis la sauvegarde automatique (fichier mews-studio-data.json
# dans votre Drive). Récupérez-le dans l'espace photographe :
# onglet Google Drive → « Sauvegarde automatique » → Clé de secours.
GOOGLE_REFRESH_TOKEN=

# --- Tri automatique des sélections sur Drive (facultatif) --------------
# Permet de créer automatiquement un dossier trié (copies réelles ou
# raccourcis) à chaque sélection envoyée par un client. Nécessite le
# compte Google du photographe (OAuth) : le compte de service ne sait
# pas écrire (pas de quota).
#  1. Créez un « Client OAuth → Application Web » dans Google Cloud
#     (API Credentials) avec l'URI de redirection :
#     https://mews-galleries.onrender.com/oauth2callback
#  2. Renseignez GOOGLE_CLIENT_ID et GOOGLE_CLIENT_SECRET ci-dessus.
#  3. Admin → Réglages → « Se connecter avec Google » → autorisez.
# Le jeton de renouvellement est ensuite conservé dans la sauvegarde
# GitHub (config.googleRefreshToken) : il survit aux redémarrages.
# NB : app non vérifiée par Google → reconnexion tous les 7 jours.
# Variables de test uniquement (ne pas renseigner en production) :
# GOOGLE_API_BASE / GOOGLE_TOKEN_URL / GOOGLE_AUTH_URL
